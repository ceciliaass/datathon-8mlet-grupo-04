# Variáveis de Ambiente - Copie para .env e preencha

# Configuração Geral
PROJECT_NAME=datathon-7mlet-grupo-XX
ENVIRONMENT=development

# Kaggle API (se usar dados do Kaggle)
KAGGLE_USERNAME=seu_usuario_kaggle
KAGGLE_KEY=sua_chave_kaggle

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=datathon_adaptive_offers

# API FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# Caminhos
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
MODELS_DIR=models
MLRUNS_DIR=mlruns

# Hiperparâmetros (opcional)
RANDOM_SEED=42
N_EPISODES=1000
N_ARMS=3
TEST_SIZE=0.2

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
