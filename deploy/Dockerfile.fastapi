FROM ubuntu:26.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \
    python3 \
    python3-venv \
    python3-pip \
    build-essential \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements if present, otherwise install common deps
COPY ./app/requirements.txt /app/requirements.txt
RUN python3 -m pip install --upgrade pip setuptools wheel || true && \
    python3 -m venv /opt/venv && \
    /opt/venv/bin/pip install --upgrade pip && \
    /opt/venv/bin/pip install --no-cache-dir -r /app/requirements.txt
ENV PATH="/opt/venv/bin:$PATH"

COPY . /app

EXPOSE 8000

# --loop asyncio --http h11: forca event loop e parser HTTP em Python puro
# (em vez de uvloop/httptools) - descarta uma classe de incompatibilidade
# sutil desses componentes em C no Fargate/ARM64.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--loop", "asyncio", "--http", "h11"]
